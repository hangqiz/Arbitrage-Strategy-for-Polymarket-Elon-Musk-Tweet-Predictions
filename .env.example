# ===== Polymarket 账户（用于下单，dry_run=True 时无需填写）=====
POLYMARKET_PRIVATE_KEY=
POLYMARKET_WALLET_ADDRESS=

# ===== CLOB API =====
CLOB_API_URL=https://clob.polymarket.com
CLOB_CHAIN_ID=137

# ===== 数据源：马斯克发帖时间戳 =====
# 可选: mock  |  csv   |  xapi
POSTING_DATA_SOURCE=mock
POSTING_DATA_PATH=./data/posts.csv
# 催化剂事件日历（催化剂门使用）
EVENTS_CSV_PATH=./data/events.csv

# ===== 目标市场 =====
MARKET_SLUG=will-elon-musk-tweet-under-2499-times-in-march

# ===== Telegram 告警（可空，空则不发送）=====
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ===== 运行模式 =====
# dry_run: 只计算不真实下单
DRY_RUN=true
POLL_INTERVAL_SEC=60